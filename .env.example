ENVIRONMENT=production
RELEASE_SHA=development
BUILD_TIME=unknown
LOG_FORMAT=json
LOG_LEVEL=INFO
POSTGRES_PASSWORD=replace-with-strong-password
API_KEY=replace-with-random-api-key
# Optional lower-privilege API keys. Roles are derived from the matching key.
MANAGER_API_KEY=
OPERATOR_API_KEY=
VIEWER_API_KEY=
WEB_PORT=8000
PUBLIC_BASE_URL=https://cleaning.example.com
# Optional Twenty CRM or another approved CRM UI. If empty, reports link to
# CleaningAIOS Mission Control, which remains the system of record.
CRM_PUBLIC_URL=
# Optional projection of verified CleaningAIOS leads into the owner's self-hosted
# Twenty workspace. Create a least-privilege key in Twenty Settings -> API &
# Webhooks, then store it only in the deployment environment.
TWENTY_ENABLED=false
TWENTY_BASE_URL=http://host.docker.internal:3020
TWENTY_API_KEY=
TWENTY_SYNC_INTERVAL_MINUTES=15
TWENTY_SYNC_BATCH_SIZE=25
TWENTY_TIMEOUT_SECONDS=15
TWENTY_MAX_RESPONSE_BYTES=128000
INTERNAL_API_URL=http://web:8000
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
# Bind the owner to one exact chat. For a private owner chat this normally
# equals OWNER_TELEGRAM_ID.
OWNER_TELEGRAM_CHAT_ID=
# Independent random secret used only for short-lived signed callback payloads.
TELEGRAM_CALLBACK_SECRET=
# Optional root URL of a separately operated local Telegram Bot API server,
# for example http://telegram-bot-api:8081. Required for downloads over 20 MB.
TELEGRAM_BOT_API_BASE_URL=
TELEGRAM_CLOUD_DOWNLOAD_LIMIT_BYTES=20000000
# Absorb brief Telegram startup timeouts without restarting the bot container.
TELEGRAM_STARTUP_MAX_ATTEMPTS=4
TELEGRAM_STARTUP_RETRY_SECONDS=5
# Pending protected-action approvals expire after this many hours.
APPROVAL_TTL_HOURS=24
# Optional routing override used only by the Telegram container. Change it if
# the default address is unreachable from the hosting provider.
TELEGRAM_API_IP=149.154.167.220
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
UNSUBSCRIBE_SECRET=
OUTREACH_RATE_LIMIT_COOLDOWN_HOURS=24
OUTREACH_PER_MINUTE=10
OUTREACH_PER_DAY=7
# Delivery opens at this local hour every day and pauses again after the daily limit.
OUTREACH_TIMEZONE=Europe/Moscow
OUTREACH_DAILY_START_HOUR=9
OUTREACH_DAILY_END_HOUR=18
OUTREACH_MIN_INTERVAL_MINUTES=30
INBOUND_MAIL_POLL_SECONDS=60
# Structured incident audit runs continuously; its owner summary is every two hours.
SYSTEM_ADMIN_INTERVAL_MINUTES=5
SYSTEM_ADMIN_REPORT_INTERVAL_MINUTES=120
SYSTEM_ADMIN_STALE_TASK_MINUTES=15
# Parallel queue consumers. Increase gradually after measuring CPU, RAM, provider
# quotas and database contention. Deployment scripts reject values outside 1..60.
AGENT_WORKER_REPLICAS=4
# Keep transient owner-channel failures alive across short provider/network outages.
OWNER_NOTIFICATION_MAX_ATTEMPTS=10
OWNER_NOTIFICATION_RETRY_MAX_SECONDS=900
AGENT_SLO_WINDOW_HOURS=24
AGENT_SLO_SUCCESS_RATE_PERCENT=95
AGENT_SLO_P95_DURATION_SECONDS=300
AGENT_STALE_RUN_MINUTES=15
# Least-privilege aggregate tools available to selected agents only.
AGENT_READ_TOOL_MAX_CALLS_PER_RUN=4
AGENT_READ_TOOL_TIMEOUT_SECONDS=35
AGENT_READ_TOOL_TOTAL_TIMEOUT_SECONDS=45
AGENT_READ_TOOL_MAX_RESULT_BYTES=64000
# Optional stateless Streamable HTTP MCP 2026-07-28 servers. Each entry must
# explicitly set mode=read_only, an agent allowlist and a finite tool allowlist.
# Keep [] until a reviewed non-PII server is approved. Secrets use MCP_READ_* refs.
AGENT_MCP_READ_SERVERS_JSON=[]
AGENT_MCP_PROTOCOL_VERSION=2026-07-28
# Isolated public-web extraction. Generate a private random bearer token, put the
# same value in CRAWL4AI_API_TOKEN, then set CRAWL4AI_ENABLED=true. Never commit it.
CRAWL4AI_ENABLED=false
CRAWL4AI_BASE_URL=http://crawl4ai:11235
CRAWL4AI_API_TOKEN=
CRAWL4AI_TIMEOUT_SECONDS=30
CRAWL4AI_MAX_RESPONSE_BYTES=2000000
CRAWL4AI_DEFAULT_CONTENT_CHARS=12000
CRAWL4AI_MAX_CONTENT_CHARS=24000

# OpenJarvis runs in an isolated internal network in production. The deployment
# creates this credential automatically without printing it. A loopback service
# remains supported for local development.
OPENJARVIS_ENABLED=false
OPENJARVIS_BASE_URL=http://host.docker.internal:8011
OPENJARVIS_API_KEY=
OPENJARVIS_MODEL=qwen3:0.6b
OPENJARVIS_TIMEOUT_SECONDS=120
OPENJARVIS_MAX_PROMPT_CHARS=4000
OPENJARVIS_MAX_RESPONSE_CHARS=3500
OPENJARVIS_MAX_RESPONSE_BYTES=128000
# Optional outbound voice gateway (recommended: a separately reviewed LiveKit or
# Pipecat service connected to a lawful SIP provider). Calls remain disabled until
# all credentials are configured; every call also needs verified contact consent
# and an exact owner approval.
TELEPHONY_ENABLED=false
TELEPHONY_GATEWAY_URL=
TELEPHONY_API_TOKEN=
TELEPHONY_WEBHOOK_SECRET=
TELEPHONY_TIMEOUT_SECONDS=20
TELEPHONY_MAX_RESPONSE_BYTES=64000
TELEPHONY_CALLS_PER_MINUTE=1
TELEPHONY_CALLS_PER_DAY=20
TELEPHONY_TIMEZONE=Europe/Moscow
TELEPHONY_DAILY_START_HOUR=10
TELEPHONY_DAILY_END_HOUR=18
CEO_REVIEW_INTERVAL_HOURS=24
# Monday (0) at 09:00 local time: one source-linked cross-domain CEO plan.
CEO_WEEKLY_BRIEF_TIMEZONE=Europe/Moscow
CEO_WEEKLY_BRIEF_WEEKDAY=0
CEO_WEEKLY_BRIEF_HOUR=9
# A verified operational summary is sent to the configured Telegram owner.
OWNER_ACTIVITY_REPORT_INTERVAL_MINUTES=60
# At this local hour the owner receives three checksum-bound PostgreSQL PDFs:
# public business prospects, CRM leads and the operational report.
DAILY_OWNER_PACK_TIMEZONE=Europe/Moscow
DAILY_OWNER_PACK_HOUR=18
# Daily read-only funnel adviser. Values above 2000 are always capped in code;
# approval only authorizes a manual test and never charges or activates ads.
MARKETING_BUDGET_ADVISOR_TIMEZONE=Europe/Moscow
MARKETING_BUDGET_ADVISOR_DAILY_HOUR=17
MARKETING_BUDGET_DAILY_LIMIT_RUB=2000
# CEO keeps one current/future task in each core development stream.
CEO_DEVELOPMENT_CADENCE_HOURS=24
# Growth Officer refreshes the 1B RUB annual revenue run-rate plan from DB facts.
GROWTH_REVIEW_INTERVAL_HOURS=24
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-terra
# auto routes CEO/business reviews to Claude when configured, request capability
# analysis to OpenAI, and uses Gemini as a fast structured fallback. Use openai,
# anthropic, or gemini to pin one provider.
LLM_PROVIDER=auto
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1200
# Run every configured business advisor in parallel for actionable owner requests.
# Fewer than two successful members is reported as degraded, never hidden.
LLM_COUNCIL_ENABLED=true
LLM_COUNCIL_MIN_MEMBERS=2
LLM_COUNCIL_MAX_MEMBERS=3
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_TIMEOUT_SECONDS=60
# Optional Google Gemini advisory fallback. Antigravity is a development client;
# the production service connects through the official Gemini API instead.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.7-flash
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_SECONDS=60
# Optional research-grounded agent coach. It receives aggregate/redacted
# telemetry only and may recommend changes; it cannot change prompts or execute tasks.
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai
PERPLEXITY_MODEL=sonar-pro
PERPLEXITY_TIMEOUT_SECONDS=60
# Aggregate, advisory-only agent quality review. Duplicate/parallel windows are suppressed.
PERPLEXITY_COACH_INTERVAL_MINUTES=30
# Bound autonomous backlog growth even if the provider returns many suggestions.
PERPLEXITY_MAX_IMPROVEMENTS_PER_CYCLE=3
PERPLEXITY_MAX_QUEUED_IMPROVEMENTS=30
# Every interval one coordinator fans out to four cited public-source scouts:
# management companies, commercial properties, tenders and public social pages.
# New/materially changed leads trigger an immediate Telegram PDF. Results become
# candidates only; consent, suppression and exact owner approval remain mandatory.
MANAGEMENT_CONTACT_SCOUT_INTERVAL_MINUTES=360
MANAGEMENT_CONTACT_SCOUT_MAX_RESULTS=20
MANAGEMENT_CONTACT_REGIONS=Санкт-Петербург|Ленинградская область|Москва|Московская область
# Monthly number of evidence-verified lead reports delivered to the owner.
# Raising this expands bounded Crawl4AI verification; it never enables outreach.
LEAD_MONTHLY_HANDOFF_TARGET=20
LEAD_REPORT_TIMEZONE=Europe/Moscow
# Monday (0) at 18:00 local time: PDF to Telegram, XLSX/CSV in report history.
CONTACT_EXPORT_TIMEZONE=Europe/Moscow
CONTACT_EXPORT_WEEKDAY=0
CONTACT_EXPORT_HOUR=18
# Candidate prompts are selected deterministically for this percentage of inputs.
# Keep 0 until the candidate passes the golden evals; set back to 0 for rollback.
PROMPT_CANDIDATE_ROLLOUT_PERCENT=0
# Non-secret stable seed keeps retries on the same prompt release.
PROMPT_ROLLOUT_SEED=cleaningaios-v1
# Daily source-grounded Evolution Researcher. Public GitHub repositories work
# without a token at the lower public API rate limit; add a read-only token only
# when a larger reviewed corpus is required.
GITHUB_RESEARCH_TOKEN=
EVOLUTION_RESEARCH_QUERIES=multi agent orchestration stars:>=500|ai agent evaluation observability stars:>=200|sales crm automation stars:>=200|marketing automation analytics stars:>=200|business forecasting mlops stars:>=200|continuous delivery rollback stars:>=500|retrieval augmented generation evaluation stars:>=500
EVOLUTION_RESEARCH_TIMEZONE=Europe/Moscow
EVOLUTION_RESEARCH_DAILY_HOUR=18
EVOLUTION_RESEARCH_MAX_SOURCES_PER_CYCLE=20
EVOLUTION_RESEARCH_MAX_IMPROVEMENTS_PER_CYCLE=3
EVOLUTION_RESEARCH_TIMEOUT_SECONDS=30
# Optional remote handoff to a published ChatGPT Workspace Agent.
WORKSPACE_AGENT_TRIGGER_ID=
WORKSPACE_AGENT_ACCESS_TOKEN=
WORKSPACE_AGENT_TIMEOUT_SECONDS=20
# Public website identity. In production the lead form stays disabled until
# COMPANY_LEGAL_NAME and PRIVACY_CONTACT_EMAIL (or COMPANY_EMAIL) are set.
COMPANY_NAME=CleaningAIOS
COMPANY_LEGAL_NAME=
COMPANY_INN=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_ADDRESS=
COMPANY_SERVICE_AREA=Москва и Московская область
PRIVACY_CONTACT_EMAIL=
# Hot CRM leads are sent here through the configured SMTP account.
OWNER_NOTIFICATION_EMAIL=
HOT_LEAD_SCORE=70
PUBLIC_LEAD_RATE_LIMIT_PER_HOUR=5
PUBLIC_LEAD_RATE_SECRET=
# Russian marketing channel credentials. Campaign activation remains manual
# and owner-approved until a channel-specific executor is enabled.
YANDEX_DIRECT_TOKEN=
YANDEX_SEARCH_API_KEY=
YANDEX_CLOUD_FOLDER_ID=
VK_ADS_TOKEN=
TWOGIS_BUSINESS_TOKEN=
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
TELEGRAM_ADS_TOKEN=
# Social publishing credentials. Content stays in approval/scheduled state until
# an official channel adapter and these administrator credentials are configured.
TELEGRAM_SOCIAL_CHAT_ID=
# Public, operator-controlled RSS sources. Feed content is treated as untrusted data.
CLEANING_NEWS_FEEDS=https://www.cleanlink.com/rss/cleanlink-rss.asp,https://www.cleanlink.com/rss/newsofinterest.asp
CLEANING_NEWS_MAX_AGE_DAYS=14
CLEANING_NEWS_TIMEOUT_SECONDS=20
VK_COMMUNITY_ID=
VK_COMMUNITY_TOKEN=
VK_API_VERSION=5.199
ODNOKLASSNIKI_GROUP_ID=
ODNOKLASSNIKI_APPLICATION_KEY=
ODNOKLASSNIKI_ACCESS_TOKEN=
ODNOKLASSNIKI_SESSION_SECRET=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Public profile links appear on the website only when they use HTTPS.
SOCIAL_TELEGRAM_URL=
SOCIAL_VK_URL=
SOCIAL_ODNOKLASSNIKI_URL=
SOCIAL_INSTAGRAM_URL=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_BASE_URL=https://api.openai.com/v1
IMAGE_GENERATION_MODEL=gpt-image-2
IMAGE_GENERATION_QUALITY=low
IMAGE_GENERATION_SIZE=1024x1024
IMAGE_GENERATION_TIMEOUT_SECONDS=120
# Enabling generation may incur provider charges and must be an explicit owner decision.
IMAGE_GENERATION_ENABLED=false
# This switch additionally enables generated visuals for scheduled social posts.
# When it is disabled, the social worker safely uses original project photos.
SOCIAL_IMAGE_GENERATION_ENABLED=false
VIDEO_GENERATION_API_KEY=
TENDER_SOURCES=
TENDER_SOURCE_TOKEN=
TENDER_REQUEST_TIMEOUT_SECONDS=30
TENDER_MONITOR_INTERVAL_MINUTES=60
TENDER_SOURCE_FRESHNESS_SLO_MINUTES=120
DOCUMENT_STORAGE_PATH=/data/documents
MAX_DOCUMENT_BYTES=50000000
PROPOSAL_FONT_PATH=
MAX_ATTACHMENT_BYTES=10000000
MAX_IMPORT_BYTES=10000000
# For each SenderMailbox.secret_ref add a matching environment variable, e.g.:
# SMTP_SALES_PASSWORD=
# For each inbound-enabled mailbox add its IMAP secret reference, e.g.:
# IMAP_SALES_PASSWORD=
