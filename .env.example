ENVIRONMENT=production
LOG_FORMAT=json
LOG_LEVEL=INFO
POSTGRES_PASSWORD=replace-with-strong-password
API_KEY=replace-with-random-api-key
# Optional lower-privilege API keys. Roles are derived from the matching key.
MANAGER_API_KEY=
OPERATOR_API_KEY=
VIEWER_API_KEY=
WEB_PORT=8000
PUBLIC_BASE_URL=https://cleaning.example.com
INTERNAL_API_URL=http://web:8000
TELEGRAM_BOT_TOKEN=
OWNER_TELEGRAM_ID=
# Bind the owner to one exact chat. For a private owner chat this normally
# equals OWNER_TELEGRAM_ID.
OWNER_TELEGRAM_CHAT_ID=
# Independent random secret used only for short-lived signed callback payloads.
TELEGRAM_CALLBACK_SECRET=
# Optional root URL of a separately operated local Telegram Bot API server,
# for example http://telegram-bot-api:8081. Required for downloads over 20 MB.
TELEGRAM_BOT_API_BASE_URL=
TELEGRAM_CLOUD_DOWNLOAD_LIMIT_BYTES=20000000
# Pending protected-action approvals expire after this many hours.
APPROVAL_TTL_HOURS=24
# Optional routing override used only by the Telegram container. Change it if
# the default address is unreachable from the hosting provider.
TELEGRAM_API_IP=149.154.167.220
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
UNSUBSCRIBE_SECRET=
OUTREACH_RATE_LIMIT_COOLDOWN_HOURS=24
OUTREACH_PER_MINUTE=10
OUTREACH_PER_DAY=7
# Delivery opens at this local hour every day and pauses again after the daily limit.
OUTREACH_TIMEZONE=Europe/Moscow
OUTREACH_DAILY_START_HOUR=9
OUTREACH_DAILY_END_HOUR=18
OUTREACH_MIN_INTERVAL_MINUTES=30
INBOUND_MAIL_POLL_SECONDS=60
# Structured incident audit runs continuously; its owner summary is daily.
SYSTEM_ADMIN_INTERVAL_MINUTES=5
SYSTEM_ADMIN_REPORT_INTERVAL_MINUTES=1440
SYSTEM_ADMIN_STALE_TASK_MINUTES=15
AGENT_SLO_WINDOW_HOURS=24
AGENT_SLO_SUCCESS_RATE_PERCENT=95
AGENT_SLO_P95_DURATION_SECONDS=300
AGENT_STALE_RUN_MINUTES=15
CEO_REVIEW_INTERVAL_HOURS=24
# A verified operational summary is sent to the configured Telegram owner.
OWNER_ACTIVITY_REPORT_INTERVAL_MINUTES=30
# CEO keeps one current/future task in each core development stream.
CEO_DEVELOPMENT_CADENCE_HOURS=24
# Growth Officer refreshes the 1B RUB annual revenue run-rate plan from DB facts.
GROWTH_REVIEW_INTERVAL_HOURS=24
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-terra
# auto routes CEO/business reviews to Claude when configured and request
# capability analysis to OpenAI. It falls back to the other configured
# provider on a transient provider error. Use openai or anthropic to pin one.
LLM_PROVIDER=auto
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1200
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_VERSION=2023-06-01
ANTHROPIC_TIMEOUT_SECONDS=60
# Optional research-grounded agent coach. It receives aggregate/redacted
# telemetry only and may recommend changes; it cannot change prompts or execute tasks.
PERPLEXITY_API_KEY=
PERPLEXITY_BASE_URL=https://api.perplexity.ai
PERPLEXITY_MODEL=sonar-pro
PERPLEXITY_TIMEOUT_SECONDS=60
# Aggregate, advisory-only agent quality review. Duplicate/parallel windows are suppressed.
PERPLEXITY_COACH_INTERVAL_MINUTES=30
# Bound autonomous backlog growth even if the provider returns many suggestions.
PERPLEXITY_MAX_IMPROVEMENTS_PER_CYCLE=3
# Daily source-grounded Evolution Researcher. Public GitHub repositories work
# without a token at the lower public API rate limit; add a read-only token only
# when a larger reviewed corpus is required.
GITHUB_RESEARCH_TOKEN=
EVOLUTION_RESEARCH_QUERIES=multi agent orchestration stars:>=500|ai agent evaluation observability stars:>=200|sales crm automation stars:>=200|marketing automation analytics stars:>=200|business forecasting mlops stars:>=200|continuous delivery rollback stars:>=500|retrieval augmented generation evaluation stars:>=500
EVOLUTION_RESEARCH_TIMEZONE=Europe/Moscow
EVOLUTION_RESEARCH_DAILY_HOUR=18
EVOLUTION_RESEARCH_MAX_SOURCES_PER_CYCLE=20
EVOLUTION_RESEARCH_MAX_IMPROVEMENTS_PER_CYCLE=3
EVOLUTION_RESEARCH_TIMEOUT_SECONDS=30
# Optional remote handoff to a published ChatGPT Workspace Agent.
WORKSPACE_AGENT_TRIGGER_ID=
WORKSPACE_AGENT_ACCESS_TOKEN=
WORKSPACE_AGENT_TIMEOUT_SECONDS=20
# Public website identity. In production the lead form stays disabled until
# COMPANY_LEGAL_NAME and PRIVACY_CONTACT_EMAIL (or COMPANY_EMAIL) are set.
COMPANY_NAME=CleaningAIOS
COMPANY_LEGAL_NAME=
COMPANY_INN=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_ADDRESS=
COMPANY_SERVICE_AREA=Москва и Московская область
PRIVACY_CONTACT_EMAIL=
# Hot CRM leads are sent here through the configured SMTP account.
OWNER_NOTIFICATION_EMAIL=
HOT_LEAD_SCORE=70
PUBLIC_LEAD_RATE_LIMIT_PER_HOUR=5
PUBLIC_LEAD_RATE_SECRET=
# Russian marketing channel credentials. Campaign activation remains manual
# and owner-approved until a channel-specific executor is enabled.
YANDEX_DIRECT_TOKEN=
YANDEX_SEARCH_API_KEY=
YANDEX_CLOUD_FOLDER_ID=
VK_ADS_TOKEN=
TWOGIS_BUSINESS_TOKEN=
AVITO_CLIENT_ID=
AVITO_CLIENT_SECRET=
TELEGRAM_ADS_TOKEN=
# Social publishing credentials. Content stays in approval/scheduled state until
# an official channel adapter and these administrator credentials are configured.
TELEGRAM_SOCIAL_CHAT_ID=
# Public, operator-controlled RSS sources. Feed content is treated as untrusted data.
CLEANING_NEWS_FEEDS=https://www.cleanlink.com/rss/cleanlink-rss.asp,https://www.cleanlink.com/rss/newsofinterest.asp
CLEANING_NEWS_MAX_AGE_DAYS=14
CLEANING_NEWS_TIMEOUT_SECONDS=20
VK_COMMUNITY_ID=
VK_COMMUNITY_TOKEN=
VK_API_VERSION=5.199
ODNOKLASSNIKI_GROUP_ID=
ODNOKLASSNIKI_APPLICATION_KEY=
ODNOKLASSNIKI_ACCESS_TOKEN=
ODNOKLASSNIKI_SESSION_SECRET=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
# Public profile links appear on the website only when they use HTTPS.
SOCIAL_TELEGRAM_URL=
SOCIAL_VK_URL=
SOCIAL_ODNOKLASSNIKI_URL=
SOCIAL_INSTAGRAM_URL=
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_BASE_URL=https://api.openai.com/v1
IMAGE_GENERATION_MODEL=gpt-image-2
IMAGE_GENERATION_QUALITY=low
IMAGE_GENERATION_SIZE=1024x1024
IMAGE_GENERATION_TIMEOUT_SECONDS=120
# Enabling generation may incur provider charges and must be an explicit owner decision.
IMAGE_GENERATION_ENABLED=false
# This switch additionally enables generated visuals for scheduled social posts.
# When it is disabled, the social worker safely uses original project photos.
SOCIAL_IMAGE_GENERATION_ENABLED=false
VIDEO_GENERATION_API_KEY=
TENDER_SOURCES=
TENDER_SOURCE_TOKEN=
TENDER_REQUEST_TIMEOUT_SECONDS=30
TENDER_MONITOR_INTERVAL_MINUTES=60
DOCUMENT_STORAGE_PATH=/data/documents
MAX_DOCUMENT_BYTES=50000000
PROPOSAL_FONT_PATH=
MAX_ATTACHMENT_BYTES=10000000
MAX_IMPORT_BYTES=10000000
# For each SenderMailbox.secret_ref add a matching environment variable, e.g.:
# SMTP_SALES_PASSWORD=
# For each inbound-enabled mailbox add its IMAP secret reference, e.g.:
# IMAP_SALES_PASSWORD=
